# OpenClaw Dashboard Environment Variables
#
# Point both API_URL and NEXT_PUBLIC_API_URL at the same OpenClaw/AgentClaw
# backend. They are read by different layers and must be kept in sync:
#   - API_URL: server-side only, read by next.config.ts to build the
#     `/api/v1/:path*` rewrite rule.
#   - NEXT_PUBLIC_API_URL: read client-side by lib/api-client.ts and
#     lib/monitoring-service.ts for all browser-originated API calls
#     (agents, templates, swarms, conversations, Prometheus metrics, etc).
#     Must include the `/api/v1` suffix.
#
# The OpenClaw backend's standard local dev port is 8001 (NOT 8000 — port
# 8000 in some local setups serves an unrelated service, e.g. a ZeroDB
# Local API instance, which will silently 404/503 every request below).
API_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# OpenClaw gateway (agent runtime control plane), used by AgentSettingsTab
# and the chat/streaming hooks.
NEXT_PUBLIC_OPENCLAW_GATEWAY_URL=http://localhost:18789
NEXT_PUBLIC_OPENCLAW_GATEWAY_TOKEN=<your-token>

# Optional: WebSocket host override for real-time message streaming
# (hooks/useTaskUpdates.ts). Defaults to the page's own host if unset.
# NEXT_PUBLIC_WS_URL=localhost:8001
